# ====================================================================
# RAG PIPELINE CONFIGURATION
# ====================================================================

# LLM Provider Configuration
# Supported providers: openai, anthropic
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Tiered LLM Routing (Cost Optimization)
# Route proactive normalization to a faster, cheaper model
NORMALIZER_MODEL=claude-3-haiku-20240307

# Vector Database (Qdrant runs locally via Docker, no API key needed)
QDRANT_URL=http://qdrant:6333

# Cache Configuration
REDIS_URL=redis://redis:6379/0

# Storage
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Observability
# We use OpenTelemetry and Prometheus natively.
# To integrate Langfuse, add keys here:
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
# SENTRY_DSN=
