# Copy to .env and fill in. Every value has a sensible default in
# app/config.py — you only need to set what you want to change.

# --- Embeddings -------------------------------------------------------
# "openai" (paid, text-embedding-3-small) or "local" (free, CPU,
# sentence-transformers — needs `pip install -r requirements-local.txt`)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Generation ---------------------------------------------------------
# "anthropic", "openai", or "none" (extractive fallback — returns the top
# retrieved chunk verbatim, no LLM call, no key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_LLM_MODEL=gpt-4o

# --- Storage --------------------------------------------------------------
# "embedded" (default): ChromaDB runs in-process, writing to CHROMA_PERSIST_DIR
# -- simplest for local dev, nothing else to run.
# "http": ChromaDB runs as its own server (docker-compose.yml's `chromadb`
# service), reached at CHROMA_HOST:CHROMA_PORT -- storage isn't tied to the
# API container's lifecycle. docker-compose sets this automatically.
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8000
COLLECTION_NAME=internal_docs

# --- Chunking (defaults match the project spec) --------------------------
DEFAULT_CHUNKING_STRATEGY=structure_aware
FIXED_CHUNK_SIZE=1000
FIXED_CHUNK_OVERLAP=150
STRUCTURE_MAX_SECTION_SIZE=1200
SEMANTIC_SIMILARITY_THRESHOLD=0.55
SEMANTIC_MAX_CHUNK_CHARS=1500
SEMANTIC_MIN_CHUNK_CHARS=200

# --- Deduplication -----------------------------------------------------------
DEDUP_SIMILARITY_THRESHOLD=0.95

# --- Retrieval -----------------------------------------------------------------
DENSE_TOP_K=10
SPARSE_TOP_K=10
HYBRID_TOP_K=5
RRF_K=60
# Per-ranker weighting in fusion (default: equal). Try weighting sparse
# higher for docs heavy on exact function names/config keys/error codes.
RRF_DENSE_WEIGHT=1.0
RRF_SPARSE_WEIGHT=1.0

# --- Reranking (optional second pass over the fused pool, off by default) ------
# "none" (default), "cross_encoder" (free, needs requirements-local.txt),
# or "llm_judge" (one batched call to whichever LLM_PROVIDER is configured)
RERANKER_PROVIDER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=20

# --- Citation verification & confidence (Phase 3) -----------------------------
# LLM-as-judge: checks each claim against the excerpt it cited, not just
# whether the citation number is in range. On by default; auto-disables
# with no LLM available (LLM_PROVIDER=none). One batched call per query.
CITATION_VERIFICATION_ENABLED=true
# Below this retrieval confidence, skip generation and return a structured
# "I don't know" naming what was found and which docs to check manually.
LOW_CONFIDENCE_THRESHOLD=0.3

# --- API -------------------------------------------------------------------------
API_PORT=8000

# --- Frontend (docker-compose only) -----------------------------------------------
# Host port for the React dashboard container (nginx listens on 80 inside
# the container regardless).
FRONTEND_PORT=5173

# Run the entire system with zero paid API keys:
#   EMBEDDING_PROVIDER=local
#   LLM_PROVIDER=none
# (requires: pip install -r requirements-local.txt, for sentence-transformers)
