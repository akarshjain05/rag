FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/api/requirements-image.txt apps/api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements-image.txt

COPY apps/api/src/rag_api ./rag_api

ENV PYTHONPATH=/app
ENV PORT=8000

CMD ["uvicorn", "rag_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
