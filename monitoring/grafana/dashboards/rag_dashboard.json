  "liveNow": false,
  "panels": [
    {
      "title": "LLM Calls Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(rag_llm_calls_total[5m])",
          "legendFormat": "{{stage}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "Median Retrieval Confidence",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_retrieval_confidence_bucket[5m])) by (le))",
          "legendFormat": "Median Confidence"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "End-to-End Latency (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/v1/ask\"}[5m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    }
  ],
  "refresh": "5s",
